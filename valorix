InfoTab:CreateSection("Создатель и Сообщество")
InfoTab:CreateParagraph({Title = "Владелец скрипта", Content = "Разработчик: Valorix"})
InfoTab:CreateParagraph({Title = "Наш Telegram канал", Content = "Официальный ТГК: @valorixscripts"})

