local Window = Rayfield:CreateWindow({
    Name = "VALORIX HUB | Район Насилия [PUBLIC]",
    LoadingTitle = "Загрузка твоей имбы...",
    LoadingSubtitle = "by Великий Валорикс (@valorixscripts)",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "ValorixHub",
        FileName = "ValorixRaionPublic"
    },
    KeySystem = false,
})

Rayfield:Notify({
    Title = "Добро пожаловать!",
    Content = "Скрипт от Великого Валорикса. Подпишись на @valorixscripts!",
    Duration = 6,
    Image = 4483362458
})

local MainTab = Window:CreateTab("Главная", 4483362458)
local VisualTab = Window:CreateTab("Визуалы (ESP)", 4483345998)
local TgTab = Window:CreateTab("Telegram & Комьюнити", 4483362458)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

local speedEnabled = false
local customSpeed = 16
local espEnabled = false

MainTab:CreateSection("Управление персонажем [Valorix Hub]")

MainTab:CreateToggle({
    Name = "Включить скорость",
    CurrentValue = false,
    Flag = "SpeedToggle",
    Callback = function(Value)
        speedEnabled = Value
    end,
})

MainTab:CreateSlider({
    Name = "Скорость бега",
    Range = {16, 120},
    Increment = 1,
    Suffix = " studs/s",
    CurrentValue = 16,
    Flag = "SpeedSlider",
    Callback = function(Value)
        customSpeed = Value
    end,
})

RunService.RenderStepped:Connect(function()
    if speedEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = customSpeed
    end
end)

VisualTab:CreateSection("Подсветка игроков")

VisualTab:CreateToggle({
    Name = "ESP Box (Highlight)",
    CurrentValue = false,
    Flag = "EspToggle",
    Callback = function(Value)
        espEnabled = Value
        if not espEnabled then
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character and p.Character:FindFirstChild("ValorixESP") then
                    p.Character.ValorixESP:Destroy()
                end
            end
        end
    end,
})

RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local char = player.Character
            if not char:FindFirstChild("ValorixESP") then
                local highlight = Instance.new("Highlight")
                highlight.Name = "ValorixESP"
                highlight.Adornee = char
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.4
                highlight.Parent = char
            end
        end
    end
end)

